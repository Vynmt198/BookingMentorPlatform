NODE_ENV=development
PORT=5001

MONGO_URI=mongodb://127.0.0.1:27018/bookingmentor

JWT_SECRET=<chuỗi-ngẫu-nhiên-dài-≥32-ký-tự>
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# VNPay — sandbox: https://sandbox.vnpayment.vn/merchantv2/
# Đăng ký URL trên cổng merchant (Danh mục website) — nếu thiếu sẽ lỗi 71 "Website chưa được phê duyệt":
#   Return URL: {BACKEND_URL}/api/payments/vnpay/vnpay-return  (hoặc VNP_RETURN_URL tùy chỉnh)
#   IPN URL:    {BACKEND_URL}/api/payments/vnpay/ipn
# Dev local: dùng ngrok cho BACKEND_URL + đăng ký URL ngrok trên cổng VNPay.
# Expo trên điện thoại thật: KHÔNG dùng localhost cho BACKEND_URL / VNP_RETURN_URL
#   → http://<IP-LAN>:5001/... (cùng Wi‑Fi). App cũng gửi apiBaseUrl để backend tự ghép.
# FRONTEND_URL: web → http://localhost:8081 ; native dùng mobileReturnUrl exp://
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Mặc định (nếu bỏ trống): {BACKEND_URL}/api/payments/vnpay/vnpay-return
VNP_RETURN_URL=

GOOGLE_CLIENT_ID=643387745996-jdlgo88csoc876tbphm9qmj50tjek9nf.apps.googleusercontent.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
CV_ANALYZER_URL=http://localhost:8000

# Tùy chọn: mã mời đăng ký tài khoản admin (Register → role admin)
# ADMIN_INVITE_CODE=

# Chia hoa hồng mentor (số thập phân 0–1)
# BOOKING_PLATFORM_FEE_RATE=0.30
# BOOKING_PLATFORM_FEE_RATE_EARLY_MENTOR=0.20
# COURSE_PLATFORM_FEE_RATE=0.35
# COURSE_PLATFORM_FEE_RATE_EARLY_MENTOR=0.25
# EARLY_MENTOR_LIMIT=20
# EARLY_MENTOR_DURATION_YEARS=1

# JAAS (8x8.vc) — phòng họp video mentor-mentee. Không set thì tự fallback meet.jit.si (giới hạn ~5' embed).
# Lấy từ https://jaas.8x8.vc/#/apikeys — App ID + API Key ID + private key (.pk file, PEM RSA).
# JAAS_APP_ID=
# JAAS_API_KEY_ID=
# JAAS_PRIVATE_KEY=            # PEM inline (dùng \n cho xuống dòng) — ưu tiên nếu set
# JAAS_PRIVATE_KEY_BASE64=     # hoặc base64 của file .pk — xem npm run encode:jaas-key
# JAAS_PRIVATE_KEY_PATH=       # hoặc đường dẫn tới file .pk trên server
# JAAS_DOMAIN=8x8.vc
# JAAS_JWT_TTL_SEC=10800
