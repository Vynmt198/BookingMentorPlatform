{
  "name": "prointerview-mobile",
  "version": "1.0.0",
  "scripts": {
    "prestart": "node scripts/kill-port.js 8081",
    "start": "expo start --lan --port 8081",
    "start:clean": "node scripts/kill-port.js 8081 && expo start --lan --port 8081 -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas:init": "eas init",
    "eas:login": "eas login",
    "version:bump": "node scripts/bump-android-version.js patch",
    "build:apk": "eas build --platform android --profile preview --non-interactive",
    "build:apk:bump": "node scripts/bump-android-version.js patch && eas build --platform android --profile preview",
    "build:aab": "eas build --platform android --profile production --non-interactive",
    "build:aab:bump": "node scripts/bump-android-version.js patch && eas build --platform android --profile production",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "^54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "^57.0.0",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "^57.0.0",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "^19.2.17",
    "eas-cli": "^16.0.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
