{
  "expo": {
    "name": "ProInterview",
    "slug": "prointerview-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f0fc",
    "icon": "./assets/logo-mark-circle.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prointerview.app",
      "buildNumber": "1",
      "backgroundColor": "#f5f0fc",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "packageName": "com.prointerview.app",
      "package": "com.prointerview.app",
      "versionCode": 1,
      "backgroundColor": "#f5f0fc",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-mark-circle.png",
        "backgroundColor": "#f5f0fc"
      },
      "navigationBar": {
        "backgroundColor": "#f5f0fc",
        "barStyle": "dark-content"
      }
    },
    "scheme": "prointerview",
    "owner": "vietvan",
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.956250299695-4sqi587k4p3ubtrpcchhjvhkfats7nbe"
        }
      ],
      "expo-updates",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép ProInterview truy cập ảnh để đổi avatar.",
          "cameraPermission": "Cho phép ProInterview dùng camera để chụp ảnh đại diện."
        }
      ]
    ]
  }
}
