{
  "expo": {
    "name": "ProInterview",
    "slug": "prointerview-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f0fc",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prointerview.app",
      "backgroundColor": "#f5f0fc"
    },
    "android": {
      "packageName": "com.prointerview.app",
      "package": "com.prointerview.app",
      "backgroundColor": "#f5f0fc",
      "usesCleartextTraffic": true,
      "navigationBar": {
        "backgroundColor": "#f5f0fc",
        "barStyle": "dark-content"
      }
    },
    "scheme": "prointerview",
    "owner": "vietvan",
    "plugins": [
      [
        "@react-native-google-signin/google-signin"
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép ProInterview truy cập ảnh để đổi avatar.",
          "cameraPermission": "Cho phép ProInterview dùng camera để chụp ảnh đại diện."
        }
      ]
    ]
  }
}
