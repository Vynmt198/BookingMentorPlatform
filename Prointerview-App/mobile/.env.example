# ========== DEV (Expo Go / local backend) ==========
EXPO_PUBLIC_API_URL=http://localhost:5001
EXPO_PUBLIC_DEV_API_HOST=172.16.35.74

# ========== PRODUCTION (EAS Build — set on expo.dev hoặc eas.json env) ==========
# EXPO_PUBLIC_API_URL=https://prointerview-backend.onrender.com
# Không set EXPO_PUBLIC_DEV_API_HOST trên production.

# Google — khớp web (VITE_GOOGLE_CLIENT_ID) và backend (GOOGLE_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=956250299695-4sqi587k4p3ubtrpcchhjvhkfats7nbe.apps.googleusercontent.com
# Build APK/AAB: tạo thêm iOS + Android OAuth client trên Google Console
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

EXPO_PUBLIC_BANK_TRANSFER_NAME=TPBank
EXPO_PUBLIC_BANK_TRANSFER_ACCOUNT=
EXPO_PUBLIC_BANK_TRANSFER_OWNER=
EXPO_PUBLIC_VIETQR_BANK_ID=TPB

# ========== Lệnh deploy (chạy trong thư mục mobile) ==========
# Lần đầu:  npm run eas:login  &&  npm run eas:init
# Build APK: npm run build:apk:bump
# OTA update (sửa JS/UI): npm run update:preview -- --message "Fix login"
# Play Store AAB: npm run build:aab:bump
