# URL backend ProInterview (dev local hoặc Render prod)
# Giữ localhost — app tự đổi sang IP LAN khi chạy Expo Go trên điện thoại (cùng Wi‑Fi với máy dev).
# Nếu vẫn không kết nối: đặt IP LAN máy dev (xem trong `npx expo start`, dòng exp://IP:8081)
EXPO_PUBLIC_API_URL=http://localhost:5001
EXPO_PUBLIC_DEV_API_HOST=

# PHẢI khớp GOOGLE_CLIENT_ID trong Prointerview-App/backend/.env
EXPO_PUBLIC_GOOGLE_CLIENT_ID=643387745996-jdlgo88csoc876tbphm9qmj50tjek9nf.apps.googleusercontent.com

# Google login trên Expo Go (auth.expo.io) đã lỗi thời — dùng:
#   • Email/password trên Expo Go
#   • Development build: npx expo run:ios | run:android (+ native Google Sign-In)
#   • Web: npx expo start --web
#
# Google Cloud Console → OAuth Web Client → Authorized redirect URIs:
#   prointerview://oauthredirect
#   http://localhost:8081
# Authorized JavaScript origins:
#   http://localhost:8081
#   http://localhost:5173

# Thông tin chuyển khoản (giống web VITE_BANK_TRANSFER_*)
EXPO_PUBLIC_BANK_TRANSFER_NAME=TPBank
EXPO_PUBLIC_BANK_TRANSFER_ACCOUNT=
EXPO_PUBLIC_BANK_TRANSFER_OWNER=
EXPO_PUBLIC_VIETQR_BANK_ID=TPB
